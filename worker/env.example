# Copy this file to .env and fill in the values.
# Apps Script Web App /exec URL (Deploy → Web app → copy the /exec link)
SHEETS_API_URL=https://script.google.com/macros/s/AKfy.../exec

# Printed by running setup() in the Apps Script editor
WORKER_KEY=wk_paste_the_generated_key_here

# Tapo account used in the Tapo mobile app for the P100 plugs
TAPO_EMAIL=you@example.com
TAPO_PASSWORD=your-tapo-password

# Polling cadence in seconds (15–30 recommended)
POLL_INTERVAL_SECONDS=20

# Newer P100 firmware uses the KLAP handshake; leave blank for the default
TAPO_ENCRYPT_TYPE=KLAP
